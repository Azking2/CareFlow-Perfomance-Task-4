<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        xmlns:svc="using:CareFlow.Services"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CareFlow Diagnostic Booking"
        Width="1050" Height="760" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="18">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="CareFlow" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="Diagnostic booking management" Foreground="#5B6472" FontSize="15" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Grid.Column="0" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#D8DEE8" Background="#FFFFFF">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock Text="New booking" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Spacing="6">
              <TextBlock Text="Patient" FontWeight="Medium" />
              <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" DisplayMemberBinding="{Binding FullName}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Booking date" FontWeight="Medium" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <DatePicker Grid.Column="0" SelectedDate="{Binding BookingDate}" />
                <Button Grid.Column="1" Content="Check availability" Command="{Binding RefreshAvailabilityCommand}" />
              </Grid>
            </StackPanel>
            <TextBlock Text="Select 1 to 3 different services" FontWeight="Medium" />
            <ItemsControl ItemsSource="{Binding Services}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceOptionViewModel">
                  <Border BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding CapacityText}" VerticalAlignment="Center" Foreground="#5B6472" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Confirm booking" Command="{Binding CreateBookingCommand}" HorizontalAlignment="Stretch" Padding="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#D8DEE8" Background="#FFFFFF">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Confirmed bookings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshBookingsCommand}" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}" MinHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="svc:BookingListItem">
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="Booking details" FontWeight="SemiBold" />
          <TextBlock Grid.Row="3" Text="{Binding SelectedBookingDetails}" TextWrapping="Wrap" MinHeight="64" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12" CornerRadius="7" Background="#F1F4F8">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
